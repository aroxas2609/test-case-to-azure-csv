# Optional: for Feedback page to send email (Resend).
# Get an API key at https://resend.com (free tier available).
# RESEND_API_KEY=re_xxxxx
# FEEDBACK_RECIPIENT_EMAIL=your-email@example.com
# Optional: custom "from" address (must be verified in Resend). Default: onboarding@resend.dev
# FEEDBACK_FROM_EMAIL=Your App <notifications@yourdomain.com>

# Optional: populate "Assigned To" suggestions (client-side).
# Must be valid JSON array of strings. Example:
# NEXT_PUBLIC_ASSIGNED_TO_OPTIONS=["Jane Smith","jane.smith@company.com","John Doe"]
